From 467ebc71fb1abfc662bcf152256087d0852184c5 Mon Sep 17 00:00:00 2001
From: "Meta Muse (independent audit)" <muse@independent-audit.local>
Date: Fri, 30 Oct 2026 07:40:10 +0800
Subject: [PATCH 3/3] test(am): rescue APIRequestContext unlocks in the Linux
 WebKit cookie adapter

workspace-root-browser unlocks via context.request.post('/api/unlock');
the response's Secure v6edit cookie never enters the WebKitGTK jar on
HTTP loopback and no page route exists for the existing adapter rescue
to intercept, so every authorized /api/workspace/* call returned 403 in
the WebKit phase while Chromium (loopback-trusting) passed. Extend the
adapter to wrap browser.newContext: after a real 200 loopback unlock
response, store exactly the server-issued v6edit value without Secure
in the test context and verify it landed. No product code, no server
auth check and no test assertion changes.
---
 .../am/portability/audit-loopback-cookie.mjs  | 38 +++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/tests/am/portability/audit-loopback-cookie.mjs b/tests/am/portability/audit-loopback-cookie.mjs
index 2a528d1..b4b94f3 100644
--- a/tests/am/portability/audit-loopback-cookie.mjs
+++ b/tests/am/portability/audit-loopback-cookie.mjs
@@ -69,6 +69,44 @@ if(basename(process.argv[1]||'').endsWith('.test.mjs')){
       } // Linux-only HTTP loopback Cookie jar adapter.
       return page;
     };
+    if(process.platform==='linux'){
+      // Suites that unlock through context.request (APIRequestContext) never
+      // pass through a page route, so the rescue above cannot see their
+      // Set-Cookie. Apply the same verified-token storage for loopback
+      // /api/unlock POSTs issued that way: only the server-issued v6edit
+      // value from the actual 200 response is stored, without Secure, in
+      // this test context. Production HTTPS behavior is unchanged.
+      const originalNewContext=browser.newContext.bind(browser);
+      browser.newContext=async function(...ctxArgs){
+        const context=await originalNewContext(...ctxArgs);
+        const originalPost=context.request.post.bind(context.request);
+        context.request.post=async function(url,...rest){
+          const response=await originalPost(url,...rest);
+          try{
+            const u=new URL(String(url));
+            if(u.protocol==='http:'&&u.hostname==='127.0.0.1'&&
+               u.pathname.endsWith('/api/unlock')&&response.status()===200){
+              const setCookie=(await response.headersArray())
+                .filter(h=>h.name.toLowerCase()==='set-cookie')
+                .map(h=>h.value).join('\n');
+              const verified=/\bv6edit=([^;]+)/.exec(setCookie);
+              if(verified&&/;\s*Secure(?=;|$)/i.test(setCookie)){
+                await context.addCookies([{name:'v6edit',value:verified[1],
+                  url:u.origin+'/',httpOnly:true,secure:false,sameSite:'Lax'}]);
+                const present=(await context.cookies(u.origin))
+                  .some(c=>c.name==='v6edit');
+                if(!present)throw Error('AUDIT_LOCAL_UNLOCK_COOKIE_NOT_STORED');
+                console.log('AUDIT_LINUX_WEBKIT_LOOPBACK_COOKIE_ADAPTER api-request-unlock-token-stored');
+              }
+            }
+          }catch(err){
+            console.log('AUDIT_LINUX_WEBKIT_LOOPBACK_COOKIE_ADAPTER api-request path skipped: '+err.message);
+          }
+          return response;
+        };
+        return context;
+      };
+    }
     return browser;
   };
 }
-- 
