{
  "name": "ocr2md",
  "private": true,
  "displayName": "ocr2md",
  "description": "VS Code extension for OCR Markdown chapter boundaries, headings, annotations, and images.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*",
    "onView:ocr2md.directory",
    "onView:ocr2md.regex",
    "onCommand:ocr2md.refreshFiles",
    "onCommand:ocr2md.pickFolder",
    "onCommand:ocr2md.openMarkdownFile",
    "onCommand:ocr2md.addCurrentLineToModule",
    "onCommand:ocr2md.openChapterBoundaryWork",
    "onCommand:ocr2md.openChapterWorkingCopy",
    "onCommand:ocr2md.exportChapterBoundaryChapters"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "markdown.previewStyles": [
      "./media/ocr2md-markdown-preview.css"
    ],
    "commands": [
      {
        "command": "ocr2md.refreshFiles",
        "title": "ocr2md: Refresh Markdown Files"
      },
      {
        "command": "ocr2md.pickFolder",
        "title": "ocr2md: Select Workspace Folder"
      },
      {
        "command": "ocr2md.openMarkdownFile",
        "title": "ocr2md: Open Markdown File"
      },
      {
        "command": "ocr2md.addCurrentLineToModule",
        "title": "ocr2md: 将当前行加入到数据表"
      },
      {
        "command": "ocr2md.openChapterBoundaryWork",
        "title": "ocr2md: 创建或打开章节定界工作稿"
      },
      {
        "command": "ocr2md.openChapterWorkingCopy",
        "title": "ocr2md: 创建或打开章节工作稿"
      },
      {
        "command": "ocr2md.exportChapterBoundaryChapters",
        "title": "ocr2md: 导出章节定界文件"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ocr2md",
          "title": "ocr2md",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ocr2md": [
        {
          "id": "ocr2md.directory",
          "name": "目录"
        },
        {
          "id": "ocr2md.regex",
          "name": "标定模块",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ocr2md.refreshFiles",
          "when": "view == ocr2md.directory",
          "group": "navigation"
        },
        {
          "command": "ocr2md.pickFolder",
          "when": "view == ocr2md.directory",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ocr2md.addCurrentLineToModule",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "navigation@9"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node ./out/chapterBoundary.test.js && node ./out/candidateLifecycle.test.js && node ./out/rowIdentity.test.js && node ./out/annotation.test.js && node ./out/scanner.test.js && node ./out/workspaceFiles.test.js && node ./out/chapterFileAssign.test.js && node ./out/webview.test.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
